    "@sentry/node": "^10.49.0",
    "clsx": "^2.1.1",
    "convex": "^1.35.1",
    "lucide-react": "^1.7.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
